{
  "name": "Home Screen",
  "id": "com.adobe.ccx.start",
  "version": "10.8.1.1",
  "manifestVersion": 5,
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "25.1.0"
    },
    {
      "app": "AI",
      "minVersion": "29.2.0"
    },
    {
      "app": "premierepro",
      "minVersion": "26.0.0"
    },
    {
      "app": "aftereffects",
      "minVersion": "24.0.0"
    },
    {
      "app": "ID",
      "minVersion": "19.3.0"
    },
    {
      "app": "indesign",
      "minVersion": "19.3.0"
    },
    {
      "app": "XD",
      "minVersion": "57.2.0"
    }
  ],
  "options": {
    "resizableDialogs": true
  },
  "entryPoints": [
    {
      "type": "homescreen",
      "id": "panel1",
      "label": {
        "default": "Homescreen"
      }
    },
    {
      "type": "welcome",
      "id": "onShowWelcomeScreen",
      "label": {
        "default": "Welcome Screen"
      }
    },
    {
      "type": "welcome-picker",
      "id": "onShowPicker",
      "label": {
        "default": "Welcome Picker"
      }
    },
    {
      "type": "import-picker",
      "id": "multiInstanceImportDocumentPicker",
      "label": {
        "default": "Import Picker"
      }
    },
    {
      "type": "link-assets",
      "id": "linkAssetsPicker",
      "label": {
        "default": "Link Assets"
      }
    },
    {
      "type": "saveas-picker",
      "id": "multiInstanceSaveAsDocumentPicker",
      "label": {
        "default": "Save as Picker"
      }
    },
    {
      "type": "relink-assets",
      "id": "relinkAssetsPicker",
      "label": {
        "default": "Relink Assets Picker"
      }
    },
    {
      "type": "close-saveas-picker",
      "id": "closeSaveAsDocumentPicker",
      "label": {
        "default": "Close Save as Picker"
      }
    },
    {
      "type": "close-import-picker",
      "id": "closeMultiInstanceImportDocumentPicker",
      "label": {
        "default": "Close Import Picker"
      }
    },
    {
      "type": "popover",
      "id": "cloud-sync-popdown",
      "label": {
        "default": "Cloud Sync Popdown"
      }
    }
  ],
  "requiredPermissions": {
    "webview": {
      "allow": "yes",
      "domains": [
        "https://*.adobe.com"
      ],
      "enableMessageBridge": "localAndRemote"
    }
  },
  "description": "CmdN: 1.32.8\n   FMS: 1.18.11\n   UAM: 1.40.0\n   UAB: 2.18.0-17\n   UAB4: 5.235.2\n   SAM.js: 10.0.697\n   AXT: 1.0.8\n   PTF: 0.8.33"
}