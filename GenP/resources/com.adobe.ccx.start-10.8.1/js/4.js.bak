NJ;;AASA;EACI,eAAA;AANJ",sourcesContent:["/* @file: projects/programmable-templates/src/react-common/components/FieldWrapper.module.scss */\n\n/* ---------------------------------------------------------------------------\n * Layout\n * --------------------------------------------------------------------------- */\n\n.fieldWrapper {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    background: transparent;\n}\n\n.fieldWrapper.sideLabel {\n    flex-direction: row;\n    align-items: flex-start;\n    /* gap not used — see above. */\n}\n\n.fieldInputArea {\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n    min-width: 0;\n}\n\n/* ---------------------------------------------------------------------------\n * Label\n * --------------------------------------------------------------------------- */\n\n.fieldLabel {\n    display: flex;\n    align-items: center;\n    font-size: var(--spectrum-global-dimension-font-size-75, 12px);\n    font-weight: var(--spectrum-alias-body-text-font-weight, 600);\n    color: var(--spectrum-alias-label-text-color, #6e6e6e);\n    line-height: 1.3;\n    /* Spacing below the label before the input area (replaces gap on .fieldWrapper). */\n    margin-bottom: 4px;\n\n    .sideLabel & {\n        min-width: 90px;\n        padding-top: 8px; /* align baseline with input text */\n        margin-bottom: 0;\n        margin-right: 8px; /* replaces gap: 8px on .fieldWrapper.sideLabel */\n    }\n}\n\n.fieldLabelDisabled {\n    color: var(--spectrum-alias-text-color-disabled, #b3b3b3);\n}\n\n/* ---------------------------------------------------------------------------\n * Necessity Indicator\n * --------------------------------------------------------------------------- */\n\n.requiredIcon {\n    color: var(--spectrum-semantic-negative-color-text-small, #d7373f);\n    font-weight: 700;\n    margin-left: 4px;\n}\n\n.necessityLabel {\n    font-weight: 400;\n    font-style: italic;\n    color: var(--spectrum-alias-label-te