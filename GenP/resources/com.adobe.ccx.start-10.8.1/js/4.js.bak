?ruleSet[1].rules[3].use[1]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[3].use[2]!./src/pt-spectrum-uxp/components/InputFallback/InputFallback.module.scss"(e,t,a){var r=a(/*! ../../../../node_modules/css-loader/dist/runtime/sourceMaps.js */"./node_modules/css-loader/dist/runtime/sourceMaps.js"),n=a(/*! ../../../../node_modules/css-loader/dist/runtime/api.js */"./node_modules/css-loader/dist/runtime/api.js")(r);n.push([e.id,".InputFallback-module_fallback__ssdQX {\n  flex-grow: 1;\n  flex-shrink: 1;\n  flex-basis: 0%;\n  min-height: 0;\n  width: 100% !important;\n  align-self: stretch;\n  background-color: transparent !important;\n}\n\ndiv.InputFallback-module_fallback__ssdQX {\n  overflow-y: auto;\n}\n\n.InputFallback-module_fallbackText__A1w5O {\n  flex-grow: 1;\n  width: 100%;\n}\n\n.InputFallback-module_fallbackPlaceholder__aq6ly {\n  color: var(--spectrum-alias-placeholder-text-color, #767676) !important;\n  font-style: italic;\n}\n\n.InputFallback-module_fallbackInvalid__Vd0IG {\n  border-color: var(--spectrum-semantic-negative-color-border, #d7373f) !important;\n}","",{version:3,sources:["webpack://./src/pt-spectrum-uxp/components/InputFallback/InputFallback.module.scss"],names:[],mappings:"AA8BA;EAKI,YAAA;EACA,cAAA;EACA,cAAA;EACA,aAAA;EACA,sBAAA;EACA,mBAAA;EACA,wCAAA;AAjCJ;;AAoCA;EAII,gBAAA;AApCJ;;AAuCA;EAII,YAAA;EACA,WAAA;AAvCJ;;AA0CA;EACI,uEAAA;EACA,kBAAA;AAvCJ;;AA0CA;EACI,gFAAA;AAvCJ",sourcesContent:["// @file: projects/programmable-templates/src/pt-spectrum-uxp/components/InputFallback/InputFallback.module.scss\n//\n// The Spectrum chrome (border, padding, font-size, theme colors) comes from the\n// className captured off the live Spectrum wrapper before it unmounted and replayed\n// on this element via the `wrapperClassName` prop (set by TextField.tsx from\n// `capturedWrapperClassName` returned by useTextFieldLogic).\n//\n// What lives here:\n//   (a) Structural flex-fill — the PTF `.multilineFill [data-pt-textfield-wrapper]`\n//       rule gave the Spectrum wrapper flex-grow/shrink/basis, min-height: 0,\n//       width: 100% !important, and align-self: stretch. InputFallback is not\n//       that Spectrum element, so these declarations are explicit here.\n//   (b) PTF-only background override — transparent over Spectrum's opaque theme\n//       resting color. !important beats Spectrum's same-specificity rule since\n//       source order cannot be guaranteed when styles load asynchronously.\n//   (c) Multiline scroll — div.fallback (multiLine=true produces a div element)\n//       mirrors the .multilineFill .inputText overflow-y rule in TextField.module.scss\n//       so the fallback scrolls identically to the native textarea.\n//   (d) PTF-only state overlays — placeholder color/style and invalid border —\n//       because Spectrum's own is-invalid / placeholder toggling stops when the\n//       native input unmounts.\n//\n// What does NOT live here (Spectrum handles via `wrapperClassName`):\n//   - Border, padding, font-size, line-height, theme colors.\n//   - opacity — unsupported in UXP CEF.\n//   - Any --multiline / --size-M / theme class rules.\n//\n// NOTE: use // (Sass silent) comments only. /* */ comments are preserved in the\n// compiled CSS, ship in the bundle, and get mangled by UXP's CEF CSS engine.\n\n.fallback {\n    // Structural: replaces the flex sizing that .multilineFill [data-pt-textfield-wrapper]\n    // gave the Spectrum wrapper. width !important overrides Spectrum's default\n    // --spectrum-field-default-width (192px, itself !important). min-height: 0\n    // lets the field shrink below Spectrum's .spectrum-Textfield--multiline min of 56px.\n    flex-grow: 1;\n    flex-shrink: 1;\n    flex-basis: 0%;\n    min-height: 0;\n    width: 100% !important;\n    align-self: stretch;\n    background-color: transparent !important;\n}\n\ndiv.fallback {\n    // Multiline only (div element = multiLine=true). Mirrors the textarea rule in\n    // TextField.module.scss: show a scrollbar only when content overflows the height\n    // allocated by the parent flex layout. UXP-only by file location (pt-spectrum-uxp).\n    overflow-y: auto;\n}\n\n.fallbackText {\n    // Fills the flex-column wrapper (Spectrum's --multiline sets flex-direction: column\n    // on the wrapper via wrapperClassName). Without flex-grow the inner div shrink-wraps\n    // to text height instead of occupying the full field height.\n    flex-grow: 1;\n    width: 100%;\n}\n\n.fallbackPlaceholder {\n    color: var(--spectrum-alias-placeholder-text-color, #767676) !important;\n    font-style: italic;\n}\n\n.fallbackInvalid {\n    border-color: var(--spectrum-semantic-negative-color-border, #d7373f) !important;\n}\n"],sourceRoot:""}]),n.locals={fallback:"InputFallback-module_fallback__ssdQX",fallbackText:"InputFallback-module_fallbackText__A1w5O",fallbackPlaceholder:"InputFallback-module_fallbackPlaceholder__aq6ly",fallbackInvalid:"InputFallback-module_fallbackInvalid__Vd0IG"},e.exports=n},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[3].use[1]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[3].use[2]!./src/pt-spectrum-uxp/components/TextField.module.scss"(e,t,a){var r=a(/*! ../../../node_modules/css-loader/dist/runtime/sourceMaps.js */"./node_modules/css-loader/dist/runtime/sourceMaps.js"),n=a(/*! ../../../node_modules/css-loader/dist/runtime/api.js */"./node_modules/css-loader/dist/runtime/api.js")(r);n.push([e.id,"[data-pt-textfield-wrapper] {\n  background-color: transparent !important;\n}\n[data-pt-textfield-wrapper] > [data-pt-textfield-fallback] {\n  margin: 0;\n  position: relative;\n  top: -1px;\n  vertical-align: baseline;\n  background-color: transparent;\n  font-family: inherit !important;\n  font-weight: inherit !important;\n  font-style: inherit !important;\n  color: inherit !important;\n}\n\n.TextField-module_multilineFill__WvJg_ [data-pt-textfield-wrapper] {\n  display: flex;\n  flex-direction: column;\n  flex-grow: 1;\n  flex-shrink: 1;\n  flex-basis: 0%;\n  min-height: 0;\n  width: 100% !important;\n  align-self: stretch;\n}\n.TextField-module_multilineFill__WvJg_ [data-pt-textfield-wrapper] > .inputText,\n.TextField-module_multilineFill__WvJg_ [data-pt-textfield-wrapper] > [data-pt-textfield-fallback] {\n  flex-grow: 1;\n  flex-shrink: 1;\n  flex-basis: 0%;\n  min-height: 0;\n  width: 100%;\n}\n.TextField-module_multilineFill__WvJg_ [data-pt-textfield-wrapper] > .inputText {\n  overflow-y: auto;\n  resize: none;\n}\n.TextField-module_multilineFill__WvJg_ [data-pt-textfield-wrapper] > [data-pt-textfield-fallback] {\n  white-space: normal;\n  word-break: normal;\n  overflow-y: auto;\n}","",{version:3,sources:["webpack://./src/pt-spectrum-uxp/components/TextField.module.scss"],names:[],mappings:"AAoEI;EACI,wCAAA;AAnER;AAsEI;EAKI,SAAA;EAMA,kBAAA;EACA,SAAA;EAEA,wBAAA;EACA,6BAAA;EAUA,+BAAA;EACA,+BAAA;EACA,8BAAA;EACA,yBAAA;AAvFR;;AAuGI;EACI,aAAA;EACA,sBAAA;EACA,YAAA;EACA,cAAA;EACA,cAAA;EACA,aAAA;EACA,sBAAA;EACA,mBAAA;AApGR;AA2GI;;EAEI,YAAA;EACA,cAAA;EACA,cAAA;EACA,aAAA;EACA,WAAA;AAzGR;AAsHI;EACI,gBAAA;EACA,YAAA;AApHR;AA2HI;EACI,mBAAA;EACA,kBAAA;EACA,gBAAA;AAzHR",sourcesContent:["// @file: projects/programmable-templates/src/pt-spectrum-uxp/components/TextField.module.scss\n//\n// UXP TextField CSS. Two scopes:\n//\n//   1. Universal (:global block) — fixes applied to the Spectrum V2 bleed-through\n//      fallback span regardless of single-line vs multiline. The same UxpTextfield\n//      code path handles both variants and swaps <input> / <textarea> with\n//      <span class=\"inputSpan\"> identically when an overlay opens.\n//\n//   2. Multiline-only (.multilineFill) — gated by the className applied in\n//      TextField.tsx when multiLine === true. Makes the wrapper a flex column\n//      so the inner element fills authored fieldCss.height. Single-line keeps\n//      Spectrum's intrinsic 32px height and doesn't need flex sizing.\n//\n// Why CSS (not imperative inline styles): authors can override any of these\n// values via the stylesheet model field, which lands as a per-instance\n// <style> tag at runtime. CSS specificity ordering with our low-specificity\n// defaults gives authors control without !important (except where we must\n// use !important to beat UxpTextfield.updateSpanStyle's inline writes).\n//\n// Selector hooks:\n//   - [data-pt-textfield-wrapper] — the .spectrum-Textfield div from\n//     Spectrum V2. Set by useTextFieldLogic in the isUXP branch.\n//   - [data-pt-textfield-fallback] — the <span class=\"inputSpan\"> rendered\n//     by UxpTextfield during the bleed-through swap. Set imperatively by\n//     useTextFieldLogic's MutationObserver since the span is rendered by\n//     @torq-native/react-spectrum and PTF can't inject the attribute at\n//     render time.\n//\n// Web TextField doesn't use FieldWrapper or the swap mechanism, so this file\n// is UXP-only.\n//\n// UXP-flex notes:\n//   - The flex shorthand isn't reliably round-tripped by UXP's CSS engine,\n//     so longhand flex-grow / flex-shrink / flex-basis are used.\n//   - min-height: 0 is needed on each flex child so they can shrink below\n//     their content's intrinsic min-height.\n//\n// NOTE: use // (Sass silent) comments only. /* */ comments are preserved in the\n// compiled CSS, ship in the bundle, and get mangled by UXP's CEF CSS engine.\n\n// Universal fallback-span fixes — apply to both single-line and multiline.\n//\n// Wrapped in :global so the attribute selectors aren't hashed by the\n// CSS-modules pipeline — the attributes are PTF-controlled (set by\n// useTextFieldLogic) and need stable global names so authors' stylesheet\n// rules can target them at the same specificity.\n:global {\n    // Force the Spectrum V2 wrapper to be transparent regardless of which\n    // theme is active.\n    //\n    // Regression introduced between 0.8.11 and 0.8.15: Spectrum V2's\n    // UxpTextfield runs componentDidUpdate on every theme switch and writes\n    // the theme's background-color as a plain inline style\n    // (element.style.backgroundColor = themeColor). A plain inline style\n    // assignment replaces the entire inline declaration — including any\n    // !important priority that PTF previously set via setProperty. After\n    // the overwrite the cascade resolves to the theme color instead of\n    // transparent.\n    //\n    // CSS author !important beats a plain (non-important) inline style, so\n    // this rule wins as long as Spectrum does NOT use setProperty with the\n    // 'important' flag (and inspection confirms it does not — the devtools\n    // show element.style { background-color: rgb(37, 37, 37); } with no\n    // !important annotation). The JS path in useTextFieldLogic still calls\n    // setProperty('background-color', 'transparent', 'important') on mount\n    // and on theme change (via ptContext.theme dep) for belt-and-suspenders\n    // coverage in environments where the CSS module may load late.\n    [data-pt-textfield-wrapper] {\n        background-color: transparent !important;\n    }\n\n    [data-pt-textfield-wrapper] > [data-pt-textfield-fallback] {\n        // Reset @torq-native/react-spectrum's uxp-style/index.styl rule\n        // .inputSpan { margin: 0px 0px 2px 2px }. The 2px left margin on a\n        // width:100% span produces scrollW > clientW and a horizontal\n        // scrollbar on the wrapper.\n        margin: 0;\n\n        // Mirror uxp-style/index.styl .inputText { position: relative; top: -1px },\n        // which applies to both <input> and <textarea> in the unswapped\n        // state. Without this, the span lands 1px lower than the native input\n        // did and the swap visually jumps.\n        position: relative;\n        top: -1px;\n\n        vertical-align: baseline;\n        background-color: transparent;\n\n        // Inherit typography from the wrapper's Spectrum-themed cascade.\n        // !important is required to beat UxpTextfield.updateSpanStyle()\n        // — it fires in componentDidUpdate and writes stale fontFamily /\n        // fontSize values inline, captured from the native input via UXP's\n        // getComputedStyle (which returns UA defaults instead of the\n        // rendered cascade for native form elements). Authored visual\n        // properties (font-size, line-height, padding, cursor, …) flow via\n        // TextFieldModel.stylesheet.\n        font-family: inherit !important;\n        font-weight: inherit !important;\n        font-style: inherit !important;\n        color: inherit !important;\n    }\n}\n\n.multilineFill {\n    // The Spectrum V2 wrapper is rendered by <Textarea /> from\n    // @react/react-spectrum. PTF marks it with\n    // data-pt-textfield-wrapper=\"true\" (PT_TEXTFIELD_WRAPPER_ATTR set in\n    // useTextFieldLogic.ts) so this selector is stable, PTF-scoped, and\n    // excludes any other Spectrum V2 textfield in the host.\n    //\n    // width: 100% !important is required to defeat Spectrum V2's default\n    // .spectrum-Textfield { width: var(--spectrum-field-default-width) }\n    // (192px), which is set with !important in Spectrum's stylesheet.\n    // align-self: stretch alone can't override an explicit width on a flex\n    // child — the explicit width: 100% is the only path to full-bleed.\n    [data-pt-textfield-wrapper] {\n        display: flex;\n        flex-direction: column;\n        flex-grow: 1;\n        flex-shrink: 1;\n        flex-basis: 0%;\n        min-height: 0;\n        width: 100% !important;\n        align-self: stretch;\n    }\n\n    // Structural sizing for the inner element — applies to both the active\n    // <textarea> and the fallback span so the flex-column layout survives\n    // the bleed-through swap. Single-line doesn't need these (its wrapper\n    // isn't a flex container outside this multilineFill scope).\n    [data-pt-textfield-wrapper] > :global(.inputText),\n    [data-pt-textfield-wrapper] > [data-pt-textfield-fallback] {\n        flex-grow: 1;\n        flex-shrink: 1;\n        flex-basis: 0%;\n        min-height: 0;\n        width: 100%;\n    }\n\n    // Scroll overflow text instead of clipping it.\n    //\n    // overflow-y: auto shows a vertical scrollbar only when the typed text\n    // exceeds the visible height of the field — there is no hard character\n    // limit. resize: none prevents UXP's native resize handle from fighting\n    // the flex-driven height; the field height is already governed by\n    // fieldCss / the parent layout.\n    //\n    // The same rule is applied to the fallback span so text remains readable\n    // (even though the span is non-editable) during the bleed-through swap.\n    [data-pt-textfield-wrapper] > :global(.inputText) {\n        overflow-y: auto;\n        resize: none;\n    }\n\n    // Multiline fallback wraps like the textarea did and scrolls vertically.\n    // Single-line keeps .inputSpan's default white-space: nowrap;\n    // overflow: hidden from uxp-style, which correctly mirrors single-line\n    // <input> semantics.\n    [data-pt-textfield-wrapper] > [data-pt-textfield-fallback] {\n        white-space: normal;\n        word-break: normal;\n        overflow-y: auto;\n    }\n}\n"],sourceRoot:""}]),n.locals={multilineFill:"TextField-module_multilineFill__WvJg_"},e.exports=n},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[3].use[1]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[3].use[2]!./src/react-common/components/CtaButton.module.scss"(e,t,a){var r=a(/*! ../../../node_modules/css-loader/dist/runtime/sourceMaps.js */"./node_modules/css-loader/dist/runtime/sourceMaps.js"),n=a(/*! ../../../node_modules/css-loader/dist/runtime/api.js */"./node_modules/css-loader/dist/runtime/api.js")(r);n.push([e.id,".CtaButton-module_ctaButton__NCe7w {\n  width: auto;\n}\n\n.CtaButton-module_ctaButtonSize-small__B7BZ5 {\n  height: 24px;\n  min-height: 24px;\n  border-radius: 12px;\n  font-size: 12px;\n}\n\n.CtaButton-module_ctaButtonIconOnly__DhoDx {\n  min-width: 32px;\n  padding: 4px;\n}\n\n