or-gray-900)));\n    }\n\n    &.disabled {\n        opacity: 0.5;\n        cursor: default;\n    }\n}\n\n.selectionIndicator {\n    position: absolute;\n    bottom: -2px !important;\n    left: 0;\n    right: 0;\n    height: 2px;\n    background-color: var(--spectrum-global-color-blue-500);\n    z-index: 10;\n\n    .vertical & {\n        bottom: 0;\n        top: 0;\n        right: -2px !important;\n        left: auto;\n        width: 2px;\n        height: auto;\n    }\n}\n\n.tabHandle {\n    display: flex;\n    align-items: center;\n    height: 100%;\n    gap: 8px;\n}\n\n.tabPanel {\n    flex-grow: 1;\n    overflow-y: auto;\n    position: relative;\n    min-height: 0;\n}\n\n.tabPanelContent {\n    height: 100%;\n    width: 100%;\n}\n"],sourceRoot:""}]),n.locals={container:"Tabs-module_container__VPQz4",vertical:"Tabs-module_vertical__ianGN",tabList:"Tabs-module_tabList__Cur2H",quiet:"Tabs-module_quiet__W2jkJ",tab:"Tabs-module_tab__A0k7g",noFocusIndicator:"Tabs-module_noFocusIndicator__lJ5L_",disabled:"Tabs-module_disabled__bE79w",selected:"Tabs-module_selected__r76ob",selectionIndicator:"Tabs-module_selectionIndicator__SGlEi",tabHandle:"Tabs-module_tabHandle__h4Eek",tabPanel:"Tabs-module_tabPanel__QiaCM",tabPanelContent:"Tabs-module_tabPanelContent__jpqRV"},e.exports=n},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[3].use[1]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[3].use[2]!./src/react-common/components/Template.module.scss"(e,t,a){var r=a(/*! ../../../node_modules/css-loader/dist/runtime/sourceMaps.js */"./node_modules/css-loader/dist/runtime/sourceMaps.js"),n=a(/*! ../../../node_modules/css-loader/dist/runtime/api.js */"./node_modules/css-loader/dist/runtime/api.js")(r);n.push([e.id,"/*\n@file: projects/programmable-templates/src/react-common/components/Template.module.scss\nTODO - fixme: position needs be passed by the client rendering the template\n */\n.Template-module_templateDefaultBackground__vRcee {\n  background-color: #fafafa; /